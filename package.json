{
  "name": "colorito",
  "version": "0.2.0",
  "description": "Render an agent answer as a styled HTML page where color tracks concepts, not emphasis. Zero dependencies, packaged as an on-demand skill.",
  "type": "module",
  "bin": {
    "colorito": "bin/colorito.mjs"
  },
  "files": [
    "bin",
    "skills",
    "examples"
  ],
  "scripts": {
    "test": "node --test test/run.mjs",
    "demo": "node bin/colorito.mjs --demo --open"
  },
  "keywords": [
    "claude-code",
    "agent-skill",
    "html",
    "markdown",
    "concept-highlighting",
    "documentation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hookdump/colorito.git"
  },
  "bugs": {
    "url": "https://github.com/hookdump/colorito/issues"
  },
  "homepage": "https://github.com/hookdump/colorito#readme",
  "author": "Ignacio Freiberg",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
